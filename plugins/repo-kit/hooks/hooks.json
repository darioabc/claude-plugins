{
  "description": "repo-kit: the plans board at session start, and a guard against heredocs inside $(...) in Bash commands",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/plans/plans.mjs\" --brief --root \"${CLAUDE_PROJECT_DIR:-.}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
